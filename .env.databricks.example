# Databricks deployment environment variables
# Copy this file to .env.databricks and fill in your values:
#   cp .env.databricks.example .env.databricks

# --- Deployment Configuration ---
DATABRICKS_APP_NAME=
DATABRICKS_WORKSPACE_PATH=

# Databricks App URL (e.g., https://myapp-id.databricksapps.com)
# Used by the backend for OAuth callback redirects.
FRONTEND_URL=https://your-databricks-app-url

# The "App Token" from your Socrata portal app (Profile → Developer Settings).
SOCRATA_APP_TOKEN=

# Socrata portal this instance is bound to. Defaults to data.wa.gov.
# Set this to target a different Socrata portal (e.g. data.cityofnewyork.us).
# The SOCRATA_APP_TOKEN above must be registered on this same domain.
# SOCRATA_DOMAIN=data.wa.gov

# Socrata catalog API domain (for categories/tags lookups). Defaults to
# api.us.socrata.com. Set to api.eu.socrata.com for EU-hosted portals.
# SOCRATA_CATALOG_DOMAIN=api.us.socrata.com

# --- LLM Configuration (optional but recommended) ---
# If unset, each user must enter their own LLM credentials in the app UI on first use.
# Set these to pre-configure the LLM for everyone using the deployed app.
LLM_ENDPOINT=https://your-endpoint.com/v1
LLM_API_KEY=your-api-key
LLM_MODEL=your-model-name

# Optional per-mode model overrides. If unset, each mode falls back to LLM_MODEL.
# UI configuration takes priority over these env values.
#   concise  — used when "Regenerate (Concise)" is invoked
#   detailed — used when "Regenerate (Detailed)" is invoked
#   suggest  — used by "Suggest Improvement" calls
# LLM_MODEL_CONCISE=
# LLM_MODEL_DETAILED=
# LLM_MODEL_SUGGEST=

# --- Socrata OAuth (optional - for "Sign in" with your portal) ---
# The "Secret Token" from the same portal app as SOCRATA_APP_TOKEN above.
# The OAuth redirect URI is derived from FRONTEND_URL at runtime
# (see backend/main.py) — no separate variable needed.
SOCRATA_SECRET_TOKEN=

# Secret for signing OAuth state tokens (used to prevent CSRF).
# If running multiple instances or workers, set this to a stable random string (e.g. 32-byte hex).
# OAUTH_STATE_SECRET=
