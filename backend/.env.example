# Python Backend Configuration for AI Metadata Improvement Tool
# Copy this file to .env and fill in your values

# Socrata API Configuration (required for Socrata open data portal access)
# Register your app via Developer Settings in your portal profile
# (e.g. data.wa.gov, data.cityofnewyork.us). The App Token is also used as
# the OAuth client_id.
SOCRATA_APP_TOKEN=

# Default Socrata portal. Defaults to data.wa.gov.
# Every Socrata-platform portal exposes the same APIs — swap the domain to
# target a different one (e.g. data.cityofnewyork.us for NYC Open Data).
# The SOCRATA_APP_TOKEN above must be registered on whichever domain is used.
# This is only the default: users can override the portal at runtime from the
# Settings page (stored per-browser in a cookie), and pasting a dataset URL on
# the Import page switches to that URL's portal automatically.
# SOCRATA_DOMAIN=data.wa.gov

# Socrata catalog API domain (for categories/tags lookups). Defaults to
# api.us.socrata.com. Set to api.eu.socrata.com for EU-hosted portals.
# SOCRATA_CATALOG_DOMAIN=api.us.socrata.com

# Socrata OAuth 2.0 (optional - powers the "Sign in" button for your portal)
# The Secret Token from your registered app. Required for OAuth to complete.
# SOCRATA_SECRET_TOKEN=
# Whether to show the "Sign in" UI. This is the sole control: set true to show
# the button, false (the default) to hide it. SOCRATA_SECRET_TOKEN does not
# affect visibility. Restart to apply (no frontend rebuild).
# ENABLE_SOCRATA_OAUTH=false
# Where the portal redirects after OAuth login (must match your registered app)
# SOCRATA_OAUTH_REDIRECT_URI=http://localhost:8000/api/auth/socrata/callback

# Whether the Settings page exposes the "Save keys" / "Save configuration" (and
# "Clear") buttons, letting users persist Socrata + LLM credentials into the
# server-side session. Defaults to false (buttons hidden; the save endpoints
# return 403). Set to true and restart to expose them (no frontend rebuild).
# ENABLE_CONFIG_SAVE=false

# How many existing portal tags the frontend offers the LLM in the Tags
# generation prompt (most popular first). Higher values let the model reach
# less-common tags at the cost of a larger prompt. Defaults to 100.
# PROMPT_TAG_CAP=100

# Cookie flags. Default Secure=true (HTTPS only) + SameSite=Lax (recommended).
# For local dev without HTTPS, set SESSION_COOKIE_SECURE=false (Vite proxy required).
# SESSION_COOKIE_SECURE=true
# SESSION_COOKIE_SAMESITE=lax

# Session cookie lifetime in seconds. Default 86400 (1 day). Applies to both
# the browser cookie Max-Age and the server-side Fernet TTL check.
# SESSION_COOKIE_MAX_AGE_SECONDS=86400

# Fernet encryption key for the session cookie. Optional.
# If omitted, a fresh key is generated on server start, which invalidates all
# sessions when the app restarts. For production, generate a key with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# SESSION_ENCRYPTION_KEY=

# Secret for signing OAuth state tokens (used to prevent CSRF). Optional.
# If running multiple instances or workers, set this to a stable random string (e.g. 32-byte hex).
# If omitted, a fresh key is generated on server start.
# OAUTH_STATE_SECRET=

# Default LLM endpoint (optional - can also be set via UI)
# Works with any OpenAI-compatible API (OpenAI, Azure, HuggingFace, etc.)
# Recommended models: gpt-5-mini, gpt-5-nano, Qwen3-4B-Instruct-2507, Qwen/Qwen3-8B,
#   mistralai/Ministral-3-8B-Instruct-2512, mistralai/Ministral-3-14B-Instruct-2512
LLM_ENDPOINT=https://api.openai.com/v1
LLM_API_KEY=your-api-key
LLM_MODEL=gpt-5-mini

# Optional per-mode model overrides. If unset, each mode falls back to LLM_MODEL.
# UI configuration takes priority over these env values.
#   concise  — used when "Regenerate (Concise)" is invoked
#   detailed — used when "Regenerate (Detailed)" is invoked
#   suggest  — used by "Suggest Improvement" calls
# LLM_MODEL_CONCISE=
# LLM_MODEL_DETAILED=
# LLM_MODEL_SUGGEST=

# Server Configuration
PORT=8000

# Frontend URL (for OAuth callback redirect during development)
# Leave empty in production when frontend is served from the same server
FRONTEND_URL=http://localhost:5173
